<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Works on any database (also production / staging without demo data) -->
    <record id="action_server_load_sample" model="ir.actions.server">
        <field name="name">Load Sample Chart</field>
        <field name="model_id" ref="model_nicu_chart"/>
        <field name="state">code</field>
        <field name="code">action = model.action_load_sample_data()</field>
        <field name="group_ids" eval="[(4, ref('group_nicu_manager'))]"/>
    </record>
</odoo>
